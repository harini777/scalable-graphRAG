# ==============================================================================
# GraphRAG Environment Configuration
# ==============================================================================

# LLM Provider Configuration
# Supported providers: "openai", "anthropic", "gemini", "groq", "ollama"
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini

# API Keys (Set the key for the provider you select)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# Ollama Configuration (if using local open weights)
OLLAMA_BASE_URL=http://localhost:11434

# Embedding Model (Sentence Transformers runs locally by default)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
DEVICE=cpu # "mps" for Apple Silicon GPU acceleration or "cpu"

# Storage & Cache Paths
DATA_DIR=./data
CACHE_DIR=./data/cache
EXPERIMENT_DIR=./experiments_output
